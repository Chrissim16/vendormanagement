{
  "name": "vendorapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "try": "tsx server/platform/jobs/try.ts",
    "dev": "concurrently -k -n server,client \"tsx watch --env-file-if-exists=.env server/main.ts\" \"vite\"",
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/platform/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed/cli.ts",
    "job": "tsx --env-file-if-exists=.env server/platform/jobs/run.ts",
    "ai:eval": "tsx --env-file-if-exists=.env server/platform/jobs/ai-eval.ts"
  },
  "dependencies": {
    "@databricks/lakebase": "^0.7.0",
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource-variable/inter": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "^5.108.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.16.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwindcss": "^3.4.19",
    "unpdf": "^1.9.1",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
