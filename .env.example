# Copy to .env for local use. Nothing here is secret; real secrets never go in this file.

# local = stand-ins for everything. databricks = the real services (set in app.yaml, not here).
PLATFORM=local
PORT=3000

# Local sign-in stand-in: who you are when running on your own machine.
DEV_USER_EMAIL=admin@example.test
# The address that becomes admin on first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test

# Leave empty to use the built-in database stored in .data/. Set to use a Postgres server instead.
DATABASE_URL=
# Where uploaded files go locally.
FILES_DIR=.data/files
