# Every setting the app reads. Copy to .env for local use; the npm scripts load it.
# Nothing here is secret. Real secrets never go in a file in this repository.

# --- Local use (all optional; these are the defaults) ---
# local = stand-ins for everything. databricks = the real services (set in app.yaml, not here).
PLATFORM=local
PORT=3000
# Who you are when running on your own machine, and who becomes admin on first sign-in.
DEV_USER_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# The team's time zone: times on screen and day filters use it.
APP_TIME_ZONE=Europe/Amsterdam
# Where the built-in database and uploaded files are kept.
DATA_DIR=.data
FILES_DIR=.data/files
# Leave empty to use the built-in database. Set to use a Postgres server instead.
DATABASE_URL=

# --- Used by tests and tooling ---
# DATABASE_MEMORY=1        built-in database in memory, gone when the app stops
# SEED_ON_START=1          load the invented sample data at start (local only)
# CLIENT_DIR=dist/client   where the built screens are served from
# TEST_DATABASE_URL=       run the server tests on this Postgres server as well
# HOST=127.0.0.1           stand-in sign-in refuses any other address
# ALLOW_REMOTE_STAND_IN=1  overrides that refusal; never use on a shared network

# --- Databricks only (set in app.yaml and by the platform; listed here for reference) ---
# BOOTSTRAP_ADMIN_EMAIL    must be a real work email; the app refuses to start otherwise
# DATABRICKS_HOST, DATABRICKS_CLIENT_ID, DATABRICKS_CLIENT_SECRET, DATABRICKS_APP_PORT, DATABRICKS_APP_NAME   supplied by Databricks Apps
# LAKEBASE_ENDPOINT        Lakebase Autoscaling (with PGHOST, PGDATABASE, PGUSER, PGPORT supplied by the resource)
# LAKEBASE_INSTANCE        Lakebase Provisioned instance name, used when LAKEBASE_ENDPOINT is not set
# VOLUME_PATH              /Volumes/<catalog>/<schema>/<volume> for uploaded documents
# AI_STRONG_ENDPOINT, AI_FAST_ENDPOINT   model serving endpoint names
# JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN
